diff --git a/gen/gen_mpy.py b/gen/gen_mpy.py
index ee61a87..71f765f 100644
--- a/gen/gen_mpy.py
+++ b/gen/gen_mpy.py
@@ -1832,7 +1832,7 @@ static unsigned long long mp_obj_get_ull(mp_obj_t obj)
 
     unsigned long long val = 0;
     bool big_endian = !(__BYTE_ORDER__ == __ORDER_LITTLE_ENDIAN__);
-    mp_obj_int_to_bytes_impl(obj, big_endian, sizeof(val), (byte*)&val);
+    mp_obj_int_to_bytes(obj, sizeof(val), (byte*)&val, big_endian, false, false);
     return val;
 }
 
diff --git a/micropython.mk b/micropython.mk
index 6aa6c3d..0ce81df 100644
--- a/micropython.mk
+++ b/micropython.mk
@@ -90,6 +90,7 @@ $(LVGL_MPY): $(ALL_LVGL_SRC) $(LVGL_BINDING_DIR)/gen/gen_mpy.py
 		-I $(LVGL_BINDING_DIR)/pycparser/utils/fake_libc_include \
