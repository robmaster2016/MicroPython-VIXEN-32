 	$(Q)$(PYTHON) $(LVGL_BINDING_DIR)/gen/gen_mpy.py -M lvgl -MP lv -MD $(LVGL_MPY_METADATA) -E $(LVGL_PP) $(LVGL_DIR)/lvgl.h > $@
 
diff --git a/lvgl/src/stdlib/micropython/lv_mem_core_micropython.c b/lvgl/src/stdlib/micropython/lv_mem_core_micropython.c
index a671b5e..14e9879 100644
--- a/lvgl/src/stdlib/micropython/lv_mem_core_micropython.c
+++ b/lvgl/src/stdlib/micropython/lv_mem_core_micropython.c
@@ -63,7 +63,11 @@ void lv_mem_remove_pool(lv_mem_pool_t pool)
 void * lv_malloc_core(size_t size)
 {
 #if MICROPY_MALLOC_USES_ALLOCATED_SIZE
-    return gc_alloc(size, true);
+    /* VIXEN-32 patch: the second argument is a flag set since MicroPython
+     * 1.21; `true` (= GC_ALLOC_FLAG_HAS_FINALISER) marked every LVGL block as
+     * a Python object with __del__, and the gc then read raw LVGL memory as a
+     * type pointer when sweeping (crash on soft reset). No flags. */
+    return gc_alloc(size, 0);
 #else
     return m_malloc(size);
 #endif
@@ -73,7 +77,7 @@ void * lv_realloc_core(void * p, size_t new_size)
 {
 
 #if MICROPY_MALLOC_USES_ALLOCATED_SIZE
-    return gc_realloc(p, new_size, true);
+    return gc_realloc(p, new_size, true);   /* here `true` = allow_move, correct */
 #else
     return m_realloc(p, new_size);
 #endif
